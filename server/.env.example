# ---- Core ----
NODE_ENV=development
PORT=4000
APP_NAME="Meridian Clinic"
# Public URL of the React app (used in email links + OAuth redirect back)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build the Google OAuth callback)
SERVER_URL=http://localhost:4000

# ---- Database (Neon / Supabase / Railway / local Postgres) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hcm?schema=public"

# ---- Auth ----
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Seeded admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@meridian.health
ADMIN_PASSWORD=Admin@12345

# ---- Booking rules ----
# How long a slot stays held while the patient fills the symptom form (minutes)
SLOT_HOLD_MINUTES=10
# How far ahead patients may book (days)
BOOKING_HORIZON_DAYS=30

# ---- LLM (Anthropic) ----
# Leave ANTHROPIC_API_KEY empty to run fully offline — the deterministic
# fallback triage kicks in and the app keeps working.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# ---- Email ----
# EMAIL_TRANSPORT: smtp | sendgrid | console
# `console` logs the rendered email instead of sending — safe for demos.
EMAIL_TRANSPORT=console
EMAIL_FROM="Meridian Clinic <no-reply@meridian.health>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# ---- Google Calendar (OAuth 2.0) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorised redirect URI in Google Cloud Console exactly
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback

# ---- Background worker ----
# true = run cron jobs inside the API process (fine for free hosting)
RUN_WORKER_IN_PROCESS=true
REMINDER_LEAD_HOURS=24
